{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mw-master-app/schema/tags.schema.json",
  "title": "tags.json",
  "description": "Themen-Tags für Module.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": true
  }
}
